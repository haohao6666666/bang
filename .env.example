# Copy to .env or configure from the local app. Never use VITE_ for a secret.
JIXIANG_TEXT_PROVIDER=qwen
JIXIANG_TEXT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JIXIANG_TEXT_MODEL=qwen-plus
JIXIANG_TEXT_API_KEY=
JIXIANG_IMAGE_PROVIDER=wan
JIXIANG_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
JIXIANG_IMAGE_MODEL=wan2.2-t2i-flash
JIXIANG_IMAGE_API_KEY=
# Optional Ark vision model. A blank vision key can reuse the configured Ark image key.
JIXIANG_VISION_MODEL=
JIXIANG_VISION_API_KEY=
